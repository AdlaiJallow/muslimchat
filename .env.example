# Supabase (Project Settings → API Keys). New sb_publishable_/sb_secret_ keys or legacy anon/service_role JWTs both work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server-only, bypasses RLS). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# LLM: any OpenAI-compatible endpoint. Defaults target Groq's free tier (console.groq.com/keys).
# Ollama example: LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# low|medium|high for reasoning models (gpt-oss); leave empty for models without it
LLM_REASONING_EFFORT=low

# Embeddings: any OpenAI-compatible endpoint. Defaults target Cloudflare Workers AI's free
# daily allowance (dash.cloudflare.com → AI → Workers AI → "Use REST API" for the account
# ID and a token). Changing the model or dimensions means a new migration + `npm run reembed`.
EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
EMBEDDING_API_KEY=...
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024

# OCR for scanned PDFs (Tesseract language codes, joined with +)
OCR_LANGS=eng+ara

# Retrieval tuning
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.45

# Comma-separated. Admins manage documents; allowed emails may create accounts (admins are always allowed).
# Set ALLOWED_EMAILS=* to let anyone sign up.
ADMIN_EMAILS=you@example.com
ALLOWED_EMAILS=
